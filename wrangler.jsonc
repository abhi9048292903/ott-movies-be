{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ott-movies-be",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["python_workers"],
  "find_additional_modules": true,
  "rules": [
    { "type": "Text", "globs": ["**/*.py"], "fallthrough": true }
  ],
  "vars": {
    "CORS_ORIGINS": "http://localhost:5173,https://ott-movies.kkabhilash72.workers.dev"
  }
}
